# Line endings: always LF, in the repository and in the working tree, on every
# platform. WordPress coding standards and the release ZIP expect LF.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# Files excluded from `git archive` (used for the release ZIP) and from the
# automatic source archives generated by GitHub. The distributed plugin must
# never contain development tooling.

/.github/          export-ignore
/tests/            export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/composer.json     export-ignore
/composer.lock     export-ignore
/phpcs.xml.dist    export-ignore
/vendor/           export-ignore
/phpunit.xml.dist  export-ignore
/.editorconfig     export-ignore
